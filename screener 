<script>
// ──────────────────────────────────────────
//  CONFIG
// ──────────────────────────────────────────
const API = ''; // empty = same origin (localhost:3000)
let liveData = [];
let filter = 'ALL';

// ──────────────────────────────────────────
//  CLOCK
// ──────────────────────────────────────────
function updateClock(){
  const n = new Date();
  document.getElementById('clock-time').textContent =
    n.toUTCString().split(' ')[4] + ' UTC';
  document.getElementById('clock-date').textContent =
    n.toLocaleDateString('en-US',{weekday:'short',year:'numeric',month:'short',day:'numeric'}).toUpperCase();
}
setInterval(updateClock,1000);
updateClock();

// ──────────────────────────────────────────
//  SIGNAL LOGIC
// ──────────────────────────────────────────
function generateSignal(change, volume){
  if(change > 2 && volume > 1000000) return 'LONG';
  if(change < -2 && volume > 1000000) return 'SHORT';
  return 'NO TRADE';
}

function fmtPrice(p){
  const n = parseFloat(p);
  if(n >= 1000) return '$' + n.toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2});
  if(n >= 1)    return '$' + n.toFixed(4);
  return '$' + n.toFixed(6);
}

function fmtVol(v){
  if(v >= 1e9) return (v/1e9).toFixed(2)+'B';
  if(v >= 1e6) return (v/1e6).toFixed(2)+'M';
  if(v >= 1e3) return (v/1e3).toFixed(1)+'K';
  return v.toFixed(0);
}

// ──────────────────────────────────────────
//  FILTER
// ──────────────────────────────────────────
function setFilter(f){
  filter = f;
  document.querySelectorAll('.ftab').forEach(b => b.classList.remove('active'));
  document.getElementById('f-'+f.toLowerCase()).classList.add('active');
  renderCoins();
}

// ──────────────────────────────────────────
//  RENDER COINS
// ──────────────────────────────────────────
function renderCoins(){
  const list = document.getElementById('coin-list');
  const data = filter === 'ALL' ? liveData : liveData.filter(c => c.signal === filter);

  if(!data.length){
    list.innerHTML = '<div class="bt-placeholder">No signals match this filter</div>';
    return;
  }

  list.innerHTML = data.map((c,i) => {
    const rowCls = c.signal==='LONG'?'sig-long':c.signal==='SHORT'?'sig-short':'sig-none';
    const sigCls = c.signal==='LONG'?'LONG':c.signal==='SHORT'?'SHORT':'NO-TRADE';
    const chgCls = c.change>=0?'pos':'neg';
    const chgStr = (c.change>=0?'+':'')+c.change.toFixed(2)+'%';
    const sym = c.symbol.replace('USDT','');
    return `<div class="coin-row ${rowCls}" style="animation-delay:${i*.03}s">
      <div>
        <div class="c-sym">${sym}<span style="font-size:8px;color:var(--muted)">/USDT</span></div>
      </div>
      <div class="c-price">${fmtPrice(c.price)}</div>
      <div class="c-chg ${chgCls}">${chgStr}</div>
      <div class="c-vol">${fmtVol(c.volume)}</div>
      <div class="sig-badge ${sigCls}">${c.signal}</div>
    </div>`;
  }).join('');
}

