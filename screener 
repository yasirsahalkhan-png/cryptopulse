// Proxies Binance API to bypass browser CORS
// Run: node server.js
// Then open: http://localhost:3000
// ============================================

const express = require("express");
const https = require("https");
const path = require("path");

const app = express();
const PORT = 3000;

// Serve the frontend dashboard
app.use(express.static(path.join(__dirname)));

// Helper: fetch from Binance over HTTPS
function binanceFetch(url) {
  return new Promise((resolve, reject) => {
    https.get(url, (res) => {
      let data = "";
      res.on("data", (chunk) => (data += chunk));
      res.on("end", () => {
        try {
          resolve(JSON.parse(data));
        } catch (e) {
          reject(new Error("Failed to parse Binance response"));
        }
      });
    }).on("error", reject);
  });
}

// ---- ROUTE: 24hr ticker (live signals) ----
app.get("/api/tickers", async (req, res) => {
  try {
    const data = await binanceFetch("https://api.binance.com/api/v3/ticker/24hr");
    res.json(data);
  } catch (e) {
    console.error("[/api/tickers]", e.message);
    res.status(500).json({ error: e.message });
  }
});

// ---- ROUTE: klines for backtest ----
app.get("/api/klines", async (req, res) => {
  const symbol = req.query.symbol || "BTCUSDT";
  const interval = req.query.interval || "1h";
  const limit = req.query.limit || 200;
  try {
    const data = await binanceFetch(
      `https://api.binance.com/api/v3/klines?symbol=${symbol}&interval=${interval}&limit=${limit}`
    );
    res.json(data);
  } catch (e) {
    console.error("[/api/klines]", e.message);
    res.status(500).json({ error: e.message });
  }
});

// ---- ROUTE: Open Interest (Futures) ----
app.get("/api/openinterest", async (req, res) => {
  const symbol = req.query.symbol || "BTCUSDT";
  try {
    const data = await binanceFetch(
      `https://fapi.binance.com/fapi/v1/openInterest?symbol=${symbol}`
    );
    res.json(data);
  } catch (e) {
    res.status(500).json({ error: e.message });
  }
});

